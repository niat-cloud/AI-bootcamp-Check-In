# Managed Postgres connection string (Neon / Supabase / Render / Railway)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Set to "false" for a local Postgres without SSL
DATABASE_SSL=true
PORT=4000

# First super admin, created on the first sign-in. Use your own values; with the default
# password (admin123) the first sign-in must set a new one.
SUPER_ADMIN_EMAIL=admin@niat.edu
SUPER_ADMIN_PASSWORD=admin123
# Long random string that signs admin sessions (defaults to a key derived from DATABASE_URL)
# AUTH_SECRET=

# AI project evaluation (optional: submissions are collected even if unset).
# Every provider with a key is used, in this order; if one fails, the next scores the project.
# OpenAI (main):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
# Google Gemini (free tier on Google AI Studio - https://aistudio.google.com):
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.0-flash
# Or Anthropic Claude:
# ANTHROPIC_API_KEY=sk-ant-...
# PROJECT_EVAL_MODEL=claude-opus-5-5
# PROJECT_EVAL_EFFORT=low

# Headless browser capture for rendering Lovable client-side apps and screenshots
# BROWSERLESS_TOKEN=
# BROWSERLESS_URL=https://production-sfo.browserless.io

